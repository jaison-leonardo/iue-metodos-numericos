# Copiar este archivo a ".env" (en la raiz del repo) y completar solo
# las claves de los proveedores que se vayan a usar. NUNCA commitear
# el archivo ".env" real con las claves reales.
# Si no se configura ninguna, el asistente funciona en modo
# determinista ("none"): sin interpretacion de lenguaje natural, pero
# con todos los metodos numericos, SymPy y SciPy funcionando igual.

# Una variable por cada cuenta/API key que se tenga. El nombre es
# libre (se referencia luego en AMN_PRIMARY_PROVIDER/AMN_FALLBACK_
# PROVIDERS), pero conviene que sea descriptivo si hay varias cuentas
# del mismo proveedor.
API_KEY_GEMINI_JAISON=
API_KEY_GEMINI_JAIME=
GROQ_API_KEY_JAISON=
OPENROUTER_API_KEY_JAISON=

# Cadena de proveedores: "proveedor:NOMBRE_DE_VARIABLE_DE_ENTORNO",
# separados por comas en AMN_FALLBACK_PROVIDERS. Proveedores
# soportados: gemini | groq | openrouter | deepseek | none.
AMN_PRIMARY_PROVIDER=gemini:API_KEY_GEMINI_JAIME
AMN_FALLBACK_PROVIDERS=openrouter:OPENROUTER_API_KEY_JAISON,groq:GROQ_API_KEY_JAISON,gemini:API_KEY_GEMINI_JAISON

# Modelo usado por cada proveedor (verificar disponibilidad en el
# panel de cada proveedor si deja de responder).
AMN_MODEL_GEMINI=gemini-flash-latest
AMN_MODEL_GROQ=openai/gpt-oss-120b
AMN_MODEL_OPENROUTER=openrouter/free
